#!/usr/bin/env bash

set -e

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

cprintf() {
	case $1 in
		r) printf "\e[31m" ;;
		g) printf "\e[32m" ;;
		b) printf "\e[34m" ;;
	esac
	printf "%b\n" "${@:2}" >&2
	printf "\e[39m"
}

main() {
	if ! command -v jq > /dev/null; then
		cprintf r "error: jq is required but not installed."
		return 1
	fi

	local conf=$XDG_CONFIG_HOME/spinner

	cprintf b "Installing config..."
	mkdir -vp "$conf"
	cp -v spinners.json "$conf/spinners.json"

	local bin=/usr/local/bin

	cprintf b "\nInstalling binary..."
	sudo cp -v spinner "$bin/spinner"
	sudo chmod -v u+x "$bin/spinner"

	cprintf g "\nInstallation complete!"
	printf 'run "spinner" to see available options\n'
}

main
